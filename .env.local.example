# Cloudinary Admin API credentials — Dashboard → Settings → API Keys
# Copy this file to .env.local (git-ignored) and fill in. Also add both to
# Vercel: Project → Settings → Environment Variables.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin login (Phase 1a) — also add all three to Vercel env vars.
# ADMIN_PASSWORD_HASH: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
#   IMPORTANT: in this file every $ in the hash must be escaped as \$ —
#   dotenv variable expansion mangles them otherwise (quotes do NOT protect).
#   Vercel's dashboard takes the raw hash unescaped.
# SESSION_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=''
SESSION_SECRET=''

# Phase D — salt for hashing inquiry IPs (sha256(ip + salt)); the raw IP is
# never stored. Dedicated salt (do NOT reuse SESSION_SECRET). Also add to Vercel.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IP_HASH_SALT=''

# Email notifications (Resend) — sent to your work email on each new inquiry.
# Runtime-only (Next reads these), so they live here + in Vercel, NOT in .env.
# Best-effort: if any is unset, inquiries still work and the send is skipped.
#   RESEND_API_KEY:      Resend dashboard → API Keys (starts with "re_").
#   INQUIRY_NOTIFY_FROM: an address on your VERIFIED domain, e.g.
#                        inquiries@saadbhatti.studio (verify it in Resend first).
#   INQUIRY_NOTIFY_TO:   where notifications land (your work email).
# (Any literal $ in a value must be escaped as \$ — Resend keys have none.)
RESEND_API_KEY=''
INQUIRY_NOTIFY_FROM=''
INQUIRY_NOTIFY_TO=''

# Event streaming (Kafka learning phase) — see docs/kafkaEventsPlan.md. OPTIONAL:
# the DB toggle at /admin/settings is OFF by default, and with these unset the
# forward is simply skipped — the site (and likes) work either way.
#   EVENT_COLLECTOR_URL: full URL the app POSTs event batches to.
#                        Local: http://localhost:8000/events  Prod: https://ingest.saadbhatti.studio/events
#   EVENT_INGEST_TOKEN:  shared bearer token; MUST match the collector's env
#                        (docker-compose defaults the collector to sbh_local_ingest).
EVENT_COLLECTOR_URL='http://localhost:8000/events'
EVENT_INGEST_TOKEN='sbh_local_ingest'

# Image search — bearer token for GET /api/catalog-index, the machine endpoint the
# CLIP embedder (embed/) reads to learn which artworks to embed. NOT under /api/admin
# (that path needs a browser cookie); this token is the auth instead. Must match the
# embedder's CATALOG_INDEX_TOKEN. Also add to Vercel. Runtime-only (keep out of .env).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CATALOG_INDEX_TOKEN=''

# Akismet comment spam filtering (OPTIONAL). Get a key at akismet.com.
#
# Leaving this unset is a SUPPORTED mode, not a broken one: the local
# heuristics still run and every comment that passes them is HELD for manual
# approval in /admin/comments. That is also the no-third-party option.
#
# With a key set, Akismet is sent the commenter's RAW IP ADDRESS — it cannot
# score without one. Nothing stores a raw IP (architecture.md invariant 6) and
# sending is not storing, but it is an outbound flow of visitor data to
# Automattic and belongs in a privacy note on the site.
AKISMET_API_KEY=

# Subscriber tokens (REQUIRED — the app refuses to boot without it).
#
# Signs the unsubscribe link in every subscriber email. Unlike every other
# integration secret here this one does NOT degrade safely: without it a
# broadcast would carry an unsubscribe link that cannot be verified, which is a
# compliance failure rather than a missing feature. Hence lib/env.ts asserts it
# at startup.
#
# Generate with:  openssl rand -base64 32
# Rotating it invalidates every unsubscribe link already sent, which is the
# only way to revoke them en masse.
SUBSCRIBE_TOKEN_SECRET=

# New-post notification to subscribers (OPTIONAL). Without these, publishing
# records SKIPPED on the post and mails nobody — visible in the admin list.
#
# RESEND_SEGMENT_ID: create the segment in the Resend dashboard first. Note
#   SEGMENT, not audience — Resend has migrated, and `audienceId` is marked
#   deprecated in five places in the installed SDK. The free marketing plan
#   includes three segments.
# BLOG_NOTIFY_FROM: deliberately separate from INQUIRY_NOTIFY_FROM, which is
#   your own notification identity — subscriber mail should have its own
#   sending reputation.
RESEND_SEGMENT_ID=
BLOG_NOTIFY_FROM=
