# Cloudinary Admin API credentials — Dashboard → Settings → API Keys
# Copy this file to .env.local (git-ignored) and fill in. Also add both to
# Vercel: Project → Settings → Environment Variables.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin login (Phase 1a) — also add all three to Vercel env vars.
# ADMIN_PASSWORD_HASH: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
#   IMPORTANT: in this file every $ in the hash must be escaped as \$ —
#   dotenv variable expansion mangles them otherwise (quotes do NOT protect).
#   Vercel's dashboard takes the raw hash unescaped.
# SESSION_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=''
SESSION_SECRET=''

# Phase D — salt for hashing inquiry IPs (sha256(ip + salt)); the raw IP is
# never stored. Dedicated salt (do NOT reuse SESSION_SECRET). Also add to Vercel.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IP_HASH_SALT=''
