# Cloudinary Admin API credentials — Dashboard → Settings → API Keys
# Copy this file to .env.local (git-ignored) and fill in. Also add both to
# Vercel: Project → Settings → Environment Variables.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin login (Phase 1a) — also add all three to Vercel env vars.
# ADMIN_PASSWORD_HASH: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
#   IMPORTANT: in this file every $ in the hash must be escaped as \$ —
#   dotenv variable expansion mangles them otherwise (quotes do NOT protect).
#   Vercel's dashboard takes the raw hash unescaped.
# SESSION_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=''
SESSION_SECRET=''

# Phase D — salt for hashing inquiry IPs (sha256(ip + salt)); the raw IP is
# never stored. Dedicated salt (do NOT reuse SESSION_SECRET). Also add to Vercel.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IP_HASH_SALT=''

# Email notifications (Resend) — sent to your work email on each new inquiry.
# Runtime-only (Next reads these), so they live here + in Vercel, NOT in .env.
# Best-effort: if any is unset, inquiries still work and the send is skipped.
#   RESEND_API_KEY:      Resend dashboard → API Keys (starts with "re_").
#   INQUIRY_NOTIFY_FROM: an address on your VERIFIED domain, e.g.
#                        inquiries@saadbhatti.studio (verify it in Resend first).
#   INQUIRY_NOTIFY_TO:   where notifications land (your work email).
# (Any literal $ in a value must be escaped as \$ — Resend keys have none.)
RESEND_API_KEY=''
INQUIRY_NOTIFY_FROM=''
INQUIRY_NOTIFY_TO=''

# Event streaming (Kafka learning phase) — see docs/kafkaEventsPlan.md. OPTIONAL:
# the DB toggle at /admin/settings is OFF by default, and with these unset the
# forward is simply skipped — the site (and likes) work either way.
#   EVENT_COLLECTOR_URL: full URL the app POSTs event batches to.
#                        Local: http://localhost:8000/events  Prod: https://ingest.saadbhatti.studio/events
#   EVENT_INGEST_TOKEN:  shared bearer token; MUST match the collector's env
#                        (docker-compose defaults the collector to sbh_local_ingest).
EVENT_COLLECTOR_URL='http://localhost:8000/events'
EVENT_INGEST_TOKEN='sbh_local_ingest'
