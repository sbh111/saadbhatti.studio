// Phase D: private inquiries ("comment log"). First database.
// Artworks are referenced by Cloudinary public_id ONLY (the 1b stable-key
// invariant), with a server-resolved title snapshot per row so the log
// survives artwork renames/deletions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (Neon -pooler in prod)
  directUrl = env("DIRECT_URL") // direct — migrate/introspect
}

enum InquiryStatus {
  NEW
  READ
}

model Inquiry {
  id              String        @id @default(cuid())
  artworkPublicId String        @db.VarChar(255) // ONLY stable artwork key
  artworkTitle    String        @db.VarChar(255) // server-resolved snapshot
  name            String        @db.VarChar(100)
  email           String        @db.VarChar(254)
  message         String        @db.VarChar(2000)
  status          InquiryStatus @default(NEW)
  ipHash          String        @db.VarChar(64) // sha256(ip + IP_HASH_SALT)
  createdAt       DateTime      @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([ipHash, createdAt])
  @@map("inquiries")
}

// Generic key/value settings. Currently the single event-streaming toggle
// (key "event_streaming_enabled", value "true"/"false"); future flags reuse it.
model Setting {
  key       String   @id @db.VarChar(64)
  value     String   @db.VarChar(255)
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// A "like" on an artwork — the one explicit interest signal. Durable and
// independent of the (toggleable) Kafka stream. Deduped one-per-visitor by the
// same salted IP hash as inquiries; the unique constraint doubles as the rate
// limit. Referenced by Cloudinary public_id only (the stable-key invariant).
model Like {
  id              String   @id @default(cuid())
  artworkPublicId String   @db.VarChar(255)
  ipHash          String   @db.VarChar(64) // sha256(ip + IP_HASH_SALT)
  createdAt       DateTime @default(now())

  @@unique([artworkPublicId, ipHash])
  @@index([artworkPublicId])
  @@map("likes")
}
