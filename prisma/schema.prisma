// Phase D: private inquiries ("comment log"). First database.
// Artworks are referenced by Cloudinary public_id ONLY (the 1b stable-key
// invariant), with a server-resolved title snapshot per row so the log
// survives artwork renames/deletions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (Neon -pooler in prod)
  directUrl = env("DIRECT_URL") // direct — migrate/introspect
}

enum InquiryStatus {
  NEW
  READ
}

// Outcome of the inquiry-notification email (sent in the background after the
// row is saved). PENDING is the initial state before the send resolves; SKIPPED
// means intentionally not sent (daily cap reached, or mail unconfigured) and
// FAILED means the send threw — both carry a human-readable reason in
// `emailError` and surface an alert + manual resend in the comment log.
enum EmailStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

model Inquiry {
  id              String        @id @default(cuid())
  artworkPublicId String        @db.VarChar(255) // ONLY stable artwork key
  artworkTitle    String        @db.VarChar(255) // server-resolved snapshot
  name            String        @db.VarChar(100)
  email           String        @db.VarChar(254)
  message         String        @db.VarChar(2000)
  status          InquiryStatus @default(NEW)
  emailStatus     EmailStatus   @default(PENDING) // notification-email outcome
  emailError      String?       @db.VarChar(500) // reason when SKIPPED/FAILED
  ipHash          String        @db.VarChar(64) // sha256(ip + IP_HASH_SALT)
  createdAt       DateTime      @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([ipHash, createdAt])
  @@map("inquiries")
}

// Per-IP rate-limit counters. A fixed-window scheme: one row per
// (bucket, ipHash, windowStart), incremented atomically via upsert. Bounded
// growth (one row per window, not per request) and the row-level increment
// avoids a count-then-write race. `ipHash` may be a pseudo-key like "__global__"
// for site-wide limits. Old windows are inert; sweep occasionally by windowStart.
model RateWindow {
  bucket      String   @db.VarChar(64) // "like" | "inquiry" | "events"
  ipHash      String   @db.VarChar(64) // salted IP hash, or a global pseudo-key
  windowStart DateTime
  count       Int      @default(0)

  @@id([bucket, ipHash, windowStart])
  @@index([windowStart])
  @@map("rate_windows")
}

// Generic key/value settings. Currently the single event-streaming toggle
// (key "event_streaming_enabled", value "true"/"false"); future flags reuse it.
model Setting {
  key       String   @id @db.VarChar(64)
  value     String   @db.VarChar(255)
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// A "like" on an artwork — the one explicit interest signal. Durable and
// independent of the (toggleable) Kafka stream. Deduped one-per-visitor by the
// same salted IP hash as inquiries; the unique constraint doubles as the rate
// limit. Referenced by Cloudinary public_id only (the stable-key invariant).
model Like {
  id              String   @id @default(cuid())
  artworkPublicId String   @db.VarChar(255)
  ipHash          String   @db.VarChar(64) // sha256(ip + IP_HASH_SALT)
  createdAt       DateTime @default(now())

  @@unique([artworkPublicId, ipHash])
  @@index([artworkPublicId])
  @@map("likes")
}

// One CLIP image embedding per artwork, keyed by the stable Cloudinary public_id.
// Written offline by the containerized Python embedder (embed/); read at search
// time by app/api/search via a raw pgvector query (the `<=>` cosine operator).
// Prisma has no native vector type, so the column is Unsupported and is never
// selected through the typed client. Dim 512 = CLIP ViT-B/32 projection.
model ArtworkEmbedding {
  publicId  String                     @id @db.VarChar(255)
  embedding Unsupported("vector(512)")
  updatedAt DateTime                   @updatedAt

  @@map("artwork_embeddings")
}
