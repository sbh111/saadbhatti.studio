// Phase D: private inquiries ("comment log"). First database.
// Artworks are referenced by Cloudinary public_id ONLY (the 1b stable-key
// invariant), with a server-resolved title snapshot per row so the log
// survives artwork renames/deletions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (Neon -pooler in prod)
  directUrl = env("DIRECT_URL") // direct — migrate/introspect
}

enum InquiryStatus {
  NEW
  READ
}

// Outcome of the inquiry-notification email (sent in the background after the
// row is saved). PENDING is the initial state before the send resolves; SKIPPED
// means intentionally not sent (daily cap reached, or mail unconfigured) and
// FAILED means the send threw — both carry a human-readable reason in
// `emailError` and surface an alert + manual resend in the comment log.
enum EmailStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

// A blog post's lifecycle. DRAFT is freely saveable and invisible publicly;
// PUBLISHED is live; ARCHIVED 404s publicly but stays in the admin list.
//
// ARCHIVED exists from this first migration even though Phase 0 ships no
// archive button: adding a value to a Postgres enum is a migration, and the
// cost of declaring it now is one word.
enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// held (scored and withheld, or not yet scored) → published (publicly
/// visible) → spam (kept, not shown, so Akismet can be given feedback and so a
/// false positive is recoverable). Nothing is ever hard-deleted by the filter.
enum CommentStatus {
  PUBLISHED
  HELD
  SPAM
}

model Inquiry {
  id              String        @id @default(cuid())
  artworkPublicId String        @db.VarChar(255) // ONLY stable artwork key
  artworkTitle    String        @db.VarChar(255) // server-resolved snapshot
  name            String        @db.VarChar(100)
  email           String        @db.VarChar(254)
  message         String        @db.VarChar(2000)
  status          InquiryStatus @default(NEW)
  emailStatus     EmailStatus   @default(PENDING) // notification-email outcome
  emailError      String?       @db.VarChar(500) // reason when SKIPPED/FAILED
  ipHash          String        @db.VarChar(64) // sha256(ip + IP_HASH_SALT)
  createdAt       DateTime      @default(now())

  @@index([createdAt(sort: Desc)])
  @@map("inquiries")
}

// Per-IP rate-limit counters. A fixed-window scheme: one row per
// (bucket, ipHash, windowStart), incremented atomically via upsert. Bounded
// growth per window (one row per window, not per request) and the row-level
// increment avoids a count-then-write race. `ipHash` may be a pseudo-key like
// "__global__" for site-wide limits. Old windows are inert and ARE swept —
// opportunistically, by `sweepStaleRateWindows()` in lib/rateLimit.ts, which
// piggybacks a small random sample of isRateLimited calls rather than a cron
// (tech debt 2.1). `rate_windows_windowStart_idx` (below) is what makes that
// sweep's own `WHERE "windowStart" < $1` selective instead of a sequential scan.
model RateWindow {
  // "like" | "events" | "search" | "search_global" | "inquiry" | "inquiry_email"
  // | "blog_like" | "blog_comment" | "blog_engagement"
  // Kept in sync by hand with the constants in lib/rateLimit.ts — this list is
  // documentation, not a constraint, and it has drifted before.
  bucket      String   @db.VarChar(64)
  ipHash      String   @db.VarChar(64) // salted IP hash, or a global pseudo-key
  windowStart DateTime
  count       Int      @default(0)

  @@id([bucket, ipHash, windowStart])
  @@index([windowStart])
  @@map("rate_windows")
}

// Generic key/value settings. Currently the single event-streaming toggle
// (key "event_streaming_enabled", value "true"/"false"); future flags reuse it.
model Setting {
  key       String   @id @db.VarChar(64)
  value     String   @db.VarChar(255)
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// A "like" on an artwork — the one explicit interest signal. Durable and
// independent of the (toggleable) Kafka stream. Deduped one-per-visitor by the
// same salted IP hash as inquiries via the unique constraint below; throughput
// is rate-limited separately, by the "like" bucket in RateWindow. Referenced by
// Cloudinary public_id only (the stable-key invariant).
model Like {
  id              String   @id @default(cuid())
  artworkPublicId String   @db.VarChar(255)
  ipHash          String   @db.VarChar(64) // sha256(ip + IP_HASH_SALT)
  createdAt       DateTime @default(now())

  @@unique([artworkPublicId, ipHash])
  @@map("likes")
}

// One CLIP image embedding per artwork, keyed by the stable Cloudinary public_id.
// Written offline by the containerized Python embedder (embed/); read at search
// time by app/api/search via a raw pgvector query (the `<=>` cosine operator).
// Prisma has no native vector type, so the column is Unsupported and is never
// selected through the typed client. Dim 512 = CLIP ViT-B/32 projection.
model ArtworkEmbedding {
  publicId  String                     @id @db.VarChar(255)
  embedding Unsupported("vector(512)")
  updatedAt DateTime                   @updatedAt

  @@map("artwork_embeddings")
}

// A blog post — the FIRST content entity this database owns. Every other table
// here holds side-channel data about artwork whose authoritative copy lives in
// Cloudinary; a post's prose exists ONLY here, which is what makes
// scripts/backup-db.sh load-bearing rather than optional (tech debt 4.3).
//
// No foreign keys on this table because it has no parent — unlike the artwork
// tables, whose parent genuinely lives in another system (docs/schema-design.md
// §1). When Phase 2 adds post_likes, those children DO get a real FK with
// ON DELETE CASCADE: `posts` is a real row in this database, so the "parent
// lives elsewhere" reasoning that produced the no-FK rule does not apply to
// them.
model Post {
  id String @id @default(cuid())

  /// PERMANENT public contract: this is the /blog/<slug> URL. Derived from the
  /// title via slugify() (lib/slug.ts) and editable ONLY while the post is a
  /// DRAFT — once published, changing it breaks every link ever shared, which
  /// is the same lesson tech debt 1.8 recorded for artwork anchors. Uniqueness
  /// is enforced here, not just by the admin create path.
  slug String @unique @db.VarChar(160)

  title String @db.VarChar(160)

  /// The index-card blurb, and the meta description once Phase 5 lands.
  /// Owner-authored, never auto-truncated from the body.
  excerpt String @db.VarChar(300)

  /// Markdown, as of Phase 1 — and still named `body` rather than
  /// `bodyMarkdown`, which is exactly why Phase 1 needed no migration for it:
  /// the change was lib/markdown.ts plus a renderer, not a column. Long bodies
  /// are TOASTed out-of-line by Postgres automatically, so
  /// `SELECT id, title, status` never pays for them.
  body String @db.VarChar(60000)

  /// Cover image: a Cloudinary public_id (e.g. "blog/kq3n8x"), never a
  /// delivery URL. Same stable-key rule as `Inquiry.artworkPublicId` and
  /// `Like.artworkPublicId` — storing a URL would bake today's transformation
  /// parameters into the database, so changing the cap or the format later
  /// would mean rewriting rows instead of editing lib/cloudinary.ts.
  ///
  /// Uploaded browser-direct under a signed ticket (lib/cloudinaryUpload.ts)
  /// into the `blog/` folder, which the catalog cannot see because
  /// `getCatalog()` reads only subfolders of CATALOG_ROOT_FOLDER ("art").
  coverPublicId String? @db.VarChar(255)

  /// Alt text for the cover. Nullable and separate from the title on purpose:
  /// a cover that merely decorates wants `alt=""`, and reusing the title would
  /// make a screen reader read it twice.
  coverAlt String? @db.VarChar(200)

  /// Intrinsic pixel dimensions as Cloudinary reported them at upload. Stored
  /// so the cover's aspect ratio can be reserved before the image loads (no
  /// layout shift) WITHOUT a round trip to the Admin API during a render.
  ///
  /// Raw width/height rather than a precomputed ratio because Phase 5's
  /// Open Graph tags need `og:image:width` / `og:image:height` as integers;
  /// a ratio cannot be turned back into them.
  coverWidth  Int?
  coverHeight Int?

  status PostStatus @default(DRAFT)

  /// Set on the FIRST transition to PUBLISHED and never rewritten, so
  /// re-publishing an old post does not reorder the public index.
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Phase 2 children. Declaring these adds no columns, but it is NOT
  /// optional: with Prisma's default `relationMode = "foreignKeys"`,
  /// schema.prisma is the source of truth, so a foreign key that exists only
  /// in migration SQL registers as drift and the next `prisma migrate dev`
  /// tries to drop it (docs/schema-design.md §1). Queries stay explicit —
  /// nothing has to traverse these navigations for them to earn their place.
  likes    PostLike[]
  comments PostComment[]

  /// Serves the one hot public query — the index's
  /// `WHERE status = 'PUBLISHED' ORDER BY "publishedAt" DESC`. `status` leads
  /// because it is always an equality predicate. The admin list
  /// (`ORDER BY updatedAt DESC`, optionally filtered) is a deliberate full
  /// scan: dozens of rows, the same call schema-design.md §4 makes for the
  /// admin likes aggregate.
  @@index([status, publishedAt(sort: Desc)])
  @@map("posts")
}

// ─── Blog engagement (Phase 2) ──────────────────────────────────────────────
// The first tables in this schema with real foreign keys. Every other table
// references artwork by Cloudinary public_id because the parent lives in
// another system; `posts` is a real row HERE, so the "parent lives elsewhere"
// reasoning behind the no-FK rule simply does not apply (docs/schema-design.md
// §1). ON DELETE CASCADE means `deletePostAction` stays a single delete, and a
// hand-written `DELETE FROM posts` in psql cleans up after itself instead of
// silently orphaning rows.

/// One visitor's like on one post. The artwork twin is `Like` above; the only
/// structural difference is the foreign key.
model PostLike {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// sha256(ip + IP_HASH_SALT) — the same salted pseudonym `likes` and
  /// `inquiries` use. Never a raw address (architecture.md invariant 6).
  ipHash    String   @db.VarChar(64)
  createdAt DateTime @default(now())

  /// The dedup mechanism, not a hint: a second like from the same visitor
  /// raises P2002, which the route turns into the same 204 a first like gets.
  /// Idempotency is enforced by the database rather than by a read-then-write
  /// race in the application.
  ///
  /// It is also the index the count query AND the cascade use, because
  /// `postId` leads it — so do NOT add a standalone `postId` index.
  /// `likes_artworkPublicId_idx` was exactly that redundancy and migration 6
  /// (`drop_unused_indexes`) removed it.
  @@unique([postId, ipHash])
  @@map("post_likes")
}

/// A visitor comment. Name only — there is deliberately no email column, so
/// there is nothing sensitive here to leak or to honour a deletion request
/// over. The cost is that Akismet scores with less signal; see lib/akismet.ts.
model PostComment {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorName String @db.VarChar(80)
  body       String @db.VarChar(2000)

  /// Defaults to HELD **in the database**, which is the real guarantee: no
  /// code path, no bug, and no hand-written INSERT can land a comment publicly
  /// without it having been scored first. Promotion to PUBLISHED happens only
  /// after the filter has run.
  status CommentStatus @default(HELD)

  /// The owner's own replies, auto-published with a badge. Comments stay flat:
  /// an owner reply covers the only threading case that matters on a blog this
  /// size, and a parentId would buy nesting nobody asked for.
  isOwner Boolean @default(false)

  /// Which heuristic held or binned it, for the moderation queue. NEVER shown
  /// publicly — it would tell a spammer exactly which rule to route around.
  spamReason String? @db.VarChar(200)

  ipHash    String   @db.VarChar(64)
  createdAt DateTime @default(now())

  /// Deliberately NO `userAgent` column. Its only plausible reader would be
  /// Akismet's submit-spam / submit-ham feedback endpoints — and those want the
  /// original request's raw IP above all, which invariant 6 forbids storing.
  /// Feeding Akismet without it trains it badly, so the feedback call is out of
  /// scope, and with it the column. Storing a visitor's user agent to supply a
  /// request this app does not make would be collecting PII-adjacent data for
  /// no reader at all.

  /// The one hot public query: `WHERE "postId" = $1 AND status = 'PUBLISHED'
  /// ORDER BY "createdAt" ASC`. ASCENDING, unlike every other index in this
  /// schema: a conversation reads oldest-first, and the declared order should
  /// match the query rather than lean on a backward scan. `postId` leads it, so
  /// it serves the cascade's child lookup too — Postgres does not index the
  /// referencing side of a foreign key for you, and without a postId-leading
  /// index every post delete would sequentially scan this table.
  ///
  /// No index on `status` alone. The moderation queue's `WHERE status = 'HELD'`
  /// is a deliberate scan, the same call §4 already records for
  /// `inquiries.emailStatus` — the admin reads a page and filters in
  /// JavaScript, and an index must serve a real access pattern rather than
  /// exist in case one appears.
  @@index([postId, status, createdAt])
  @@map("post_comments")
}
