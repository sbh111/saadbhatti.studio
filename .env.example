# Copy to .env (git-ignored). Read by the Prisma CLI and Next.js.
# NOTE: any literal $ in a value must be escaped as \$ (dotenv-expand runs in
# both Next and Prisma). Vercel's dashboard takes raw values, unescaped.

# Local development (Docker: docker compose up -d) — pooled = direct locally:
DATABASE_URL="postgresql://sbh:sbh_local_dev@localhost:5432/sbh_studio"
DIRECT_URL="postgresql://sbh:sbh_local_dev@localhost:5432/sbh_studio"

# Production (Neon) shapes — set these in Vercel, not here:
#   DATABASE_URL = postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true
#   DIRECT_URL   = postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require
