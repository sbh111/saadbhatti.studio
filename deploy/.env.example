# Copy to deploy/.env (git-ignored) ON THE EC2 BOX and fill in.
# EVENT_INGEST_TOKEN must MATCH the value set in Vercel's env vars.
#   generate: openssl rand -base64 32
EVENT_INGEST_TOKEN=
# The public hostname Porkbun points at this instance; Caddy gets a cert for it.
INGEST_DOMAIN=ingest.saadbhatti.studio
